<?xml version="1.0" encoding="utf-8"?>
<!-- Media: three tabs and Settings across the top, then one page at a time. Search is a field and a grid of
     posters; Downloads and Coming up are lists. Margins keep everything inside the 5% a TV may crop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button android:id="@+id/tab_search" style="@style/Homelab.Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_search" />
        <Button android:id="@+id/tab_downloads" style="@style/Homelab.Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_downloads" />
        <Button android:id="@+id/tab_upcoming" style="@style/Homelab.Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/tab_upcoming" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button android:id="@+id/settings" style="@style/Homelab.Pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:text="@string/settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1">

        <!-- Search -->
        <LinearLayout
            android:id="@+id/page_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/query"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_field"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/mic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/pill"
                    android:contentDescription="@string/voice_search"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/pill_text"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/search_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />

            <ScrollView
                android:id="@+id/search_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadingEdgeLength="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="27dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <GridLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="6"
                    android:useDefaultMargins="false" />
            </ScrollView>
        </LinearLayout>

        <!-- Downloads -->
        <LinearLayout
            android:id="@+id/page_downloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/downloads_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="27dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Coming up -->
        <LinearLayout
            android:id="@+id/page_upcoming"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/upcoming_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="27dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/upcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

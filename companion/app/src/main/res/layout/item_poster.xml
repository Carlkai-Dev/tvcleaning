<?xml version="1.0" encoding="utf-8"?>
<!-- One search result: the poster (or its title on a plain card when there is none), FILM or SHOW top left, a
     tick top right when it is already in the library, then the title and year. The whole card takes focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/poster_card_width"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="7dp">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="154dp"
        android:layout_height="231dp"
        android:background="@drawable/poster_frame"
        android:duplicateParentState="true"
        android:padding="3dp">

        <TextView
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/kind"
            style="@style/Homelab.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp" />

        <TextView
            android:id="@+id/owned"
            style="@style/Homelab.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/badge_ok"
            android:text="@string/owned_badge"
            android:textColor="@color/bg"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="154dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/year"
        android:layout_width="154dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>

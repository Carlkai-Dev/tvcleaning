<?xml version="1.0" encoding="utf-8"?>
<!-- Homepage full screen, with a loading state, an error state that says what went wrong and offers Try again
     and Settings, and a hint that fades after the first load. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dash_loading"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="64dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/dash_error_title"
            android:textColor="@color/text"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button android:id="@+id/retry" style="@style/Homelab.Pill"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/dash_retry" />
            <Button android:id="@+id/open_settings" style="@style/Homelab.Pill"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="27dp"
        android:background="@drawable/badge"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/dash_hint"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tabs and buttons: white when focused (unmistakable from across the room), a soft tint when they are the
     current tab, glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#40FFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#1AFFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
</selector>

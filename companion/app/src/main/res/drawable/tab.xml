<?xml version="1.0" encoding="utf-8"?>
<!-- Tabs: white when focused (unmistakable from across the room), an accent tint on the current tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/accent_soft" /><corners android:radius="24dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="24dp" /></shape></item>
</selector>

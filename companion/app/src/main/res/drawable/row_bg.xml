<?xml version="1.0" encoding="utf-8"?>
<!-- List rows and tabs: a soft glass highlight only while focused, so D-pad position is always visible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#22FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>

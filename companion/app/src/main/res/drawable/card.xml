<?xml version="1.0" encoding="utf-8"?>
<!-- Rows (settings, downloads, calendar): a raised surface, lifted and ringed in white while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_hi" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="16dp" /></shape>
    </item>
</selector>

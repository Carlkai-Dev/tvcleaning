<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Homelab" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF9FD8FF</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Tabs and buttons on the Media and Dashboard screens: pills that turn white when focused. -->
    <style name="Homelab.Pill" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Homelab.Badge" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/badge</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>

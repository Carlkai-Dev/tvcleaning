<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The whole point of this app: it talks to the servers named in config.json (Immich, Homepage,
         Sonarr, Radarr) and nowhere else. The launcher itself stays without this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only so Settings can make the Immich slideshow the screensaver with one press. A TV never grants
         this to an app by itself; build-and-install.sh does it over ADB (pm grant). Without it, the
         button opens the TV's screensaver settings instead. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: Search's mic button shows only when something can take voice input. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_homelab"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Homelab"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The whole app, one launcher tile: Dashboard, Search, Downloads, Coming up and Settings as tabs. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The screensaver's gear in the TV's settings (dream_info.xml): the same app, starting on Settings. -->
        <activity-alias
            android:name=".SettingsActivity"
            android:exported="true"
            android:targetActivity=".MainActivity" />

        <!-- One film or show from a search, opened by the Search tab only. -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- The screensaver's slideshow as an activity, to try a config without waiting for the dream:
             tools/tv.py 'am start -n io.github.epochcoder.homelab/.SlideshowActivity'. No launcher tile. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Immich screensaver: build-and-install.sh SCREENSAVER=1 selects it, or the TV's screensaver settings. -->
        <service
            android:name=".PhotoDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

        <!-- push-config.sh writes a whole config.json (URLs, API keys, ca_pem) through this into private storage,
             so the keys never sit on /sdcard. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't.
             Write and delete only; nothing can read the file back through it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>

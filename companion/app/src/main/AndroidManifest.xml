<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The whole point of this app: it talks to the servers named in config.json (Immich, Homepage,
         Sonarr, Radarr) and nowhere else. The launcher itself stays without this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_homelab"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Homelab"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Homepage (gethomepage.dev) full screen. A grid tile on the launcher. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/dashboard_name"
            android:banner="@drawable/banner"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Every setting, edited with the remote. A grid tile, and the screensaver's gear in the TV's settings. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_name"
            android:banner="@drawable/banner_settings"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- push-config.sh writes a whole config.json (URLs, API keys, ca_pem) through this into private storage,
             so the keys never sit on /sdcard. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't.
             Write and delete only; nothing can read the file back through it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>

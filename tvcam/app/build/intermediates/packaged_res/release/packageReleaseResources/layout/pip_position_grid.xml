<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pipPosGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/pipPos0" style="@style/PipPosBtn" android:text="TL" />
        <Button android:id="@+id/pipPos1" style="@style/PipPosBtn" android:text="TC" />
        <Button android:id="@+id/pipPos2" style="@style/PipPosBtn" android:text="TR" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/pipPos3" style="@style/PipPosBtn" android:text="ML" />
        <Button android:id="@+id/pipPos4" style="@style/PipPosBtn" android:text="C" />
        <Button android:id="@+id/pipPos5" style="@style/PipPosBtn" android:text="MR" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/pipPos6" style="@style/PipPosBtn" android:text="BL" />
        <Button android:id="@+id/pipPos7" style="@style/PipPosBtn" android:text="BC" />
        <Button android:id="@+id/pipPos8" style="@style/PipPosBtn" android:text="BR" />
    </LinearLayout>
</LinearLayout>

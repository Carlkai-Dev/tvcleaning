<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2A3548"
                android:endColor="#121820"
                android:angle="135" />
        </shape>
    </item>
    <item
        android:left="28dp"
        android:top="28dp"
        android:right="28dp"
        android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#334455" />
            <stroke android:width="2dp" android:color="#5A6A80" />
        </shape>
    </item>
</layer-list>

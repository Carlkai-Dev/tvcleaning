<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D1E3A5F" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF38BDF8" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#330284C7" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#8038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0B1729" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1A38BDF8" />
        </shape>
    </item>
</selector>

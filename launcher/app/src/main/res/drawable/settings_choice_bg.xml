<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings rows, in the quick settings' glass: white under focus, the current choice in blue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#590A84FF" android:endColor="#380A84FF" />
            <stroke android:width="1.5dp" android:color="#FF0A84FF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>

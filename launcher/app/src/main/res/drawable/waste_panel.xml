<?xml version="1.0" encoding="utf-8"?>
<!-- Bin calendar card: dark glass with a thin light outline, nearly opaque like the weather cards beside it, so
     its rows stay readable over a busy downloaded photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#E61C2440" android:endColor="#E60E1428" />
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="20dp" />
</shape>

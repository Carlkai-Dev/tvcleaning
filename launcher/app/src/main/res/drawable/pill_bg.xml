<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF8FAFC" />
            <stroke android:width="2dp" android:color="#FF38BDF8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#590284C7" />
            <stroke android:width="1.5dp" android:color="#FF38BDF8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#290E2442" android:endColor="#1F09182E" />
            <stroke android:width="1dp" android:color="#3338BDF8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>

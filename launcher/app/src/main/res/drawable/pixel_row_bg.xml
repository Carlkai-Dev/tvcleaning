<?xml version="1.0" encoding="utf-8"?>
<!-- Fork de Natalia, estilo Pixel: una fila de los menús (entradas, ajustes) como los módulos de los ajustes rápidos:
     tono claro, y el color primario mientras está enfocada. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF00687A" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFBBD8E3" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</selector>

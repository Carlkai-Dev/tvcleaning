<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for an HDMI input tile on the Home screen: a deep blue gradient with the HDMI glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1E40AF" android:endColor="#FF0F172A" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_input" />
</layer-list>

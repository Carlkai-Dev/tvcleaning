<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <stroke android:width="1.5dp" android:color="#FF00E5FF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2600E5FF" android:endColor="#1810141E" />
            <stroke android:width="1dp" android:color="#5900E5FF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
    <RadioButton android:id="@+id/tvButtonPickerSelected" android:layout_width="48dp"
        android:layout_height="48dp" android:focusable="false" android:clickable="false"
        android:importantForAccessibility="no" android:buttonTint="#FFFFFFFF" />
    <TextView android:id="@+id/tvButtonPickerLabel" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="match_parent" android:gravity="start|center_vertical"
        android:textDirection="locale" android:textColor="#FFFFFFFF" android:textSize="20sp"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>

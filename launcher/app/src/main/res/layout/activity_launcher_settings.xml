<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's own settings, in the same glass as quick settings (styles.xml, Settings*). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="44dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.01" />

        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="30dp"
            android:text="@string/columns_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="-12dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="30dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="22dp"
            android:text="@string/follow_theme" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="8dp"
            android:text="@string/follow_theme_hint" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="30dp"
            android:text="@string/home_settings" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="8dp"
            android:text="@string/home_settings_help" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="22dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>

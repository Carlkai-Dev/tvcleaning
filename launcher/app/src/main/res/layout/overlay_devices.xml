<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devicesOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60A0C10"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDevClose"
                        style="@style/TopButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="18sp"
                        android:nextFocusLeft="@id/btnDevClose"
                        android:nextFocusRight="@id/tvDevRefresh"
                        android:nextFocusUp="@id/btnDevClose"
                        android:nextFocusDown="@id/devicesContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="RM-OS Cihaz &amp; Ağ Takibi"
                        android:textColor="#FFFFFFFF"
                        android:textSize="32sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:letterSpacing="0.08"
                    android:text="DAAK FABRIC SEVILLA // CANLI DÜĞÜM VE BAĞLANTI DURUMU"
                    android:textAllCaps="true"
                    android:textColor="#34D399"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDevRefresh"
                style="@style/TopButton"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Yenile"
                android:drawableStart="@drawable/ic_wifi"
                android:nextFocusLeft="@id/btnDevClose"
                android:nextFocusRight="@id/tvDevRefresh"
                android:nextFocusUp="@id/tvDevRefresh"
                android:nextFocusDown="@id/devicesContainer" />
        </RelativeLayout>

        <!-- Devices Grid -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/devicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>

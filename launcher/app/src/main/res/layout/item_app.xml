<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the Zen list: an index, then the app's name in large light type.
  No artwork, no tile, no card: the row is text on the wallpaper.
  The height is fixed so a focused row can grow its type without moving the rows around it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_row_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/list_row_bg"
        android:paddingStart="18dp"
        android:paddingEnd="26dp">

        <TextView
            android:id="@+id/index"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:textColor="#33FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.2"
            android:includeFontPadding="false"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#52FFFFFF"
            android:textSize="@dimen/list_name_size"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#40FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

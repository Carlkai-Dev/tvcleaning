<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/tile_width"
        android:layout_height="@dimen/tile_height"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:clickable="true">

        <FrameLayout
            android:id="@+id/artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tile_bg">

            <ImageView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="5dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Artwork size + 6 dp per side, matching GlassView.HALO_INSET_DP.
             Explicit centered bounds keep the halo's fade layer clear of the artwork edges. -->
        <com.gathin.tvhome.GlassView
            android:id="@+id/tileGlass"
            android:layout_width="@dimen/tile_halo_width"
            android:layout_height="@dimen/tile_halo_height"
            android:layout_gravity="center"
            android:alpha="0"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="@dimen/tile_width"
        android:layout_height="18dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="78dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.02" />
</FrameLayout>

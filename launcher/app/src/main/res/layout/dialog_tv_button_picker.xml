<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:layoutDirection="ltr">
    <TextView android:id="@+id/tvButtonPickerTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/tv_button" android:textColor="#FFFFFFFF" android:textSize="24sp"
        android:gravity="start" android:textDirection="locale" android:paddingBottom="12dp"
        android:accessibilityHeading="true" />
    <ListView android:id="@+id/tvButtonPickerList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="4dp"
        android:descendantFocusability="blocksDescendants" android:listSelector="@drawable/tv_picker_focus"
        android:drawSelectorOnTop="false" android:scrollbarStyle="insideInset" />
    <Button android:id="@+id/tvButtonPickerCancel" android:layout_width="wrap_content"
        android:layout_height="52dp" android:layout_gravity="end" android:layout_marginTop="12dp"
        android:text="@android:string/cancel" android:textDirection="locale" />
</LinearLayout>

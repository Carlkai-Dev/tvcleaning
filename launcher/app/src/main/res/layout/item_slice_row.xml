<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Picture & Sound panel: title, value ("‹ Standard ›", "0", "›") and, for seekbars, a bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/ps_row"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@drawable/ps_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:singleLine="true"
            android:ellipsize="end" />
        <View
            android:id="@+id/dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/status_dot"
            android:visibility="gone" />
        <TextView
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@drawable/ps_value"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:background="@drawable/ps_track"
        android:duplicateParentState="true"
        android:visibility="gone">
        <View
            android:id="@+id/fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/ps_fill"
            android:duplicateParentState="true" />
        <View
            android:id="@+id/rest"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The settings sheet's volume row: Left and Right change the volume, OK mutes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="14dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:tint="#FFFFFFFF"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_volume"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:singleLine="true" />

        <com.gathin.tvhome.LevelBar
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum" />
</LinearLayout>

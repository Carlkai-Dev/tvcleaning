<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07111F">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Main Vertical UI Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="22dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Header: Greeting, Clock, Date, and Top Quick Action Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#F8FAFC"
                        android:textSize="46sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="7dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="7dp"
                        android:background="#2E38BDF8" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="7dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="16sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="4dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/stats"
                android:layout_width="0dp"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_alignEnd="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Cinematic Apple TV / Google TV Hero Spotlight -->
        <LinearLayout
            android:id="@+id/heroLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/heroBadgeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/heroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_sapphire_bg"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.08"
                    android:text="4K ULTRA HD" />

                <TextView
                    android:id="@+id/heroAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_sapphire_bg"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.06"
                    android:text="▶ PRESS OK TO OPEN" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#F8FAFC"
                android:textSize="36sp"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:text="Cinema &amp; Series" />
        </LinearLayout>

        <!-- Main Grid Container: Favourites Dock + Installed Applications -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>

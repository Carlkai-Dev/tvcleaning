<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings: a glass panel on the right, Home dimmed behind it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000">

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="2dp"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:fontFamily="@font/geist"
            android:fontVariationSettings="'wght' 400" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:text="@string/launcher_settings_hint"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/geist" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp"
    android:gravity="center" android:orientation="horizontal">
    <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
        android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps" />
    <!-- config.xml library_launcher_settings: Launcher settings after the App library. -->
    <TextView android:id="@+id/btnLibrarySettings" style="@style/TopButton"
        android:layout_marginStart="16dp" android:text="@string/launcher_settings"
        android:drawableStart="@drawable/ic_home_settings_pill" android:visibility="gone" />
</LinearLayout>

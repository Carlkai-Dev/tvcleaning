+                        android:letterSpacing="-0.02"
+                        android:text="October 2026"
+                        android:textColor="#FFFFFFFF"
+                        android:textSize="32sp" />
+                </LinearLayout>
+
+                <TextView
+                    android:id="@+id/tvCalSubtitle"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginStart="58dp"
+                    android:layout_marginTop="2dp"
+                    android:fontFamily="@font/outfit"
+                    android:fontVariationSettings="'wght' 400"
+                    android:letterSpacing="0.08"
+                    android:text="DOMINGO, 18 OCTUBRE — Bugün planlanan etkinlik yok"
+                    android:textAllCaps="true"
+                    android:textColor="#38BDF8"
+                    android:textSize="13sp" />
+            </LinearLayout>
+
+            <LinearLayout
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_alignParentEnd="true"
+                android:layout_centerVertical="true"
+                android:orientation="horizontal">
+
+                <TextView
+                    android:id="@+id/btnCalPrev"
+                    style="@style/TopButton"
+                    android:layout_width="42dp"
+                    android:layout_height="42dp"
+                    android:paddingStart="0dp"
+                    android:paddingEnd="0dp"
+                    android:gravity="center"
+                    android:text="‹"
+                    android:textSize="22sp"
+                    android:nextFocusLeft="@id/btnCalClose"
+                    android:nextFocusRight="@id/btnCalToday"
+                    android:nextFocusUp="@id/btnCalPrev"
+                    android:nextFocusDown="@id/calGridTable" />
+
+                <TextView
+                    android:id="@+id/btnCalToday"
+                    style="@style/TopButton"
+                    android:text="Today"
+                    android:nextFocusLeft="@id/btnCalPrev"
+                    android:nextFocusRight="@id/btnCalNext"
+                    android:nextFocusUp="@id/btnCalToday"
+                    android:nextFocusDown="@id/calGridTable" />

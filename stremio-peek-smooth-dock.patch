+            <TextView style="@style/CalDayHeader" android:text="MON" />
+            <TextView style="@style/CalDayHeader" android:text="TUE" />
+            <TextView style="@style/CalDayHeader" android:text="WED" />
+            <TextView style="@style/CalDayHeader" android:text="THU" />
+            <TextView style="@style/CalDayHeader" android:text="FRI" />
+            <TextView style="@style/CalDayHeader" android:text="SAT" />
+        </LinearLayout>
+
+        <!-- Calendar Month Grid Container -->

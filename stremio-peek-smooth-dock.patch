+                    android:textSize="22sp"
+                    android:nextFocusLeft="@id/btnCalToday"
+                    android:nextFocusRight="@id/btnCalNext"
+                    android:nextFocusUp="@id/btnCalNext"
+                    android:nextFocusDown="@id/calGridTable" />
+            </LinearLayout>
+        </RelativeLayout>
+
+        <!-- Days of Week Header -->
